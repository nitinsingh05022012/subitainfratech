  <!DOCTYPE html>
<html lang="hi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>SUBITA INFRATECH | Construction & Infrastructure</title>

  <meta name="description" content="SUBITA INFRATECH - Construction, Infrastructure, Residential and Commercial Development Company.">

  <!-- GOOGLE FONTS -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- FONT AWESOME -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --maroon: #650f25;
      --maroon-dark: #3b0715;
      --maroon-light: #8e2943;
      --gold: #c7a66c;
      --gold-light: #e2c88f;
      --dark: #090d10;
      --white: #ffffff;
      --light: #f7f7f5;
      --light-2: #eef0f2;
      --text: #18202a;
      --gray: #64748b;
      --border: rgba(15, 23, 42, 0.10);
      --shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
    }

    /* RESET */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', 'Noto Sans Devanagari', sans-serif;
      background: var(--white);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      font-family: 'Outfit', 'Noto Sans Devanagari', sans-serif;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    ul {
      list-style: none;
    }

    .container {
      width: min(1240px, 90%);
      margin: auto;
    }

    /* =========================
   TOP BAR
========================= */
    .topbar {
      background: var(--maroon-dark);
      color: #fff;
      font-size: 13px;
      padding: 11px 0;
    }

    .topbar-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .topbar-info {
      display: flex;
      gap: 25px;
      align-items: center;
    }

    .topbar-info span,
    .topbar-info a {
      color: #f1f5f9;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: .3s;
    }

    .topbar-info a:hover {
      color: var(--gold-light);
    }

    /* =========================
   HEADER
========================= */
    .header {
      position: sticky;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(255, 255, 255, .97);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(15, 23, 42, .10);
      box-shadow: 0 5px 25px rgba(0, 0, 0, .05);
    }

    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 95px;
    }

    /* MAIN LOGO */
    .logo {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .logo img {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      object-fit: contain;
      border: 2px solid var(--gold);
      background: #fff;
      display: block;
    }

    .logo-text span {
      display: block;
      color: #111827;
      font-family: 'Outfit', sans-serif;
      font-weight: 900;
      font-size: 22px;
      letter-spacing: 1px;
      line-height: 1.1;
    }

    .logo-text small {
      color: var(--gold);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    /* NAVIGATION */
    .nav-menu {
      display: flex;
      align-items: center;
      gap: 30px;
    }

    .nav-menu a {
      color: #1e293b;
      font-size: 14px;
      font-weight: 600;
      transition: .3s;
    }

    .nav-menu a:hover {
      color: var(--maroon);
    }

    .nav-cta {
      background: var(--maroon);
      color: #fff !important;
      padding: 12px 26px;
      border-radius: 6px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: .3s;
    }

    .nav-cta:hover {
      background: var(--maroon-light);
      transform: translateY(-2px);
    }

    .menu-toggle {
      display: none;
      background: none;
      border: none;
      color: #111827;
      font-size: 28px;
      cursor: pointer;
    }

    /* =========================
   HERO / BANNER
========================= */
    .hero {
      min-height: 90vh;
      display: flex;
      align-items: center;
      position: relative;
      color: #fff;
      padding: 100px 0;
      background-image:
        linear-gradient(90deg,
          rgba(5, 8, 12, .90) 0%,
          rgba(5, 8, 12, .72) 48%,
          rgba(5, 8, 12, .30) 100%),
        url('https://images.unsplash.com/photo-1541888946425-d0fbb18f86f8?auto=format&fit=crop&w=2000&q=85');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .hero-content {
      max-width: 780px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 15px;
      color: var(--gold-light);
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 25px;
    }

    .hero-badge span::after {
      content: '|';
      margin-left: 15px;
      color: rgba(255, 255, 255, .45);
    }

    .hero-badge span:last-child::after {
      content: '';
    }

    .hero h1 {
      font-size: clamp(42px, 6.5vw, 72px);
      line-height: 1.06;
      font-weight: 900;
      letter-spacing: -1.5px;
      margin-bottom: 25px;
    }

    .hero h1 span {
      color: var(--gold-light);
    }

    .hero p {
      font-family: 'Noto Sans Devanagari', 'Plus Jakarta Sans', sans-serif;
      font-size: 18px;
      color: #f1f5f9;
      max-width: 700px;
      margin-bottom: 40px;
    }

    .hero-btns {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    /* BUTTONS */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 16px 34px;
      border-radius: 6px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: .3s;
    }

    .btn-primary {
      background: var(--maroon);
      color: #fff;
      border: 1px solid var(--maroon);
    }

    .btn-primary:hover {
      background: var(--maroon-light);
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(101, 15, 37, .35);
    }

    .btn-outline {
      background: rgba(255, 255, 255, .10);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, .65);
      backdrop-filter: blur(5px);
    }

    .btn-outline:hover {
      border-color: var(--gold);
      color: var(--gold-light);
      background: rgba(255, 255, 255, .15);
    }

    /* =========================
   STATS
========================= */
    .stats-strip {
      background: var(--maroon);
      color: #fff;
      padding: 45px 0;
      border-top: 3px solid var(--gold);
      border-bottom: 3px solid var(--gold);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      text-align: center;
    }

    .stat-box h3 {
      font-size: 42px;
      font-weight: 900;
      color: var(--gold-light);
      margin-bottom: 5px;
    }

    .stat-box p {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 700;
      color: #f8fafc;
    }

    /* =========================
   GENERAL SECTIONS
========================= */
    section {
      padding: 110px 0;
      background: var(--white);
    }

    section:nth-of-type(even) {
      background: var(--light);
    }

    .sec-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 65px;
    }

    .sec-tag {
      color: var(--gold);
      font-weight: 800;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 3px;
      margin-bottom: 12px;
      display: inline-block;
    }

    .sec-title {
      font-size: clamp(32px, 4.5vw, 48px);
      font-weight: 900;
      letter-spacing: -1px;
      line-height: 1.1;
      margin-bottom: 15px;
      color: #111827;
    }

    .sec-title span {
      color: var(--maroon);
    }

    .sec-desc {
      color: var(--gray);
      font-size: 16px;
    }

    /* =========================
   ABOUT
========================= */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-img-wrap {
      position: relative;
    }

    .about-img-wrap img {
      width: 100%;
      height: 500px;
      object-fit: cover;
      border-radius: 14px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }

    .about-card-badge {
      position: absolute;
      bottom: -35px;
      right: -35px;
      background: var(--maroon);
      color: #fff;
      padding: 35px;
      border-radius: 14px;
      box-shadow: var(--shadow);
      border: 4px solid var(--white);
    }

    .about-card-badge h4 {
      font-size: 38px;
      font-weight: 900;
      color: var(--gold-light);
      line-height: 1;
    }

    .about-card-badge p {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 700;
      margin-top: 5px;
    }

    .about .sec-desc {
      font-family: 'Noto Sans Devanagari', 'Plus Jakarta Sans', sans-serif;
    }

    .about-features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 35px;
    }

    .about-feat-item {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 14px;
      color: #334155;
    }

    .about-feat-item i {
      color: #fff;
      background: var(--maroon);
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
    }

    /* =========================
   SERVICES
========================= */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .service-card {
      background: #fff;
      padding: 45px 35px;
      border-radius: 14px;
      border: 1px solid var(--border);
      transition: .4s;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, .04);
    }

    .service-card::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: var(--gold);
      transition: .4s;
      transform: scaleX(0);
      transform-origin: left;
    }

    .service-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow);
      border-color: var(--gold);
    }

    .service-card:hover::after {
      transform: scaleX(1);
    }

    .service-icon {
      width: 70px;
      height: 70px;
      background: rgba(199, 166, 108, .12);
      color: var(--maroon);
      font-size: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      margin-bottom: 25px;
      border: 1px solid rgba(199, 166, 108, .35);
    }

    .service-card h3 {
      font-size: 21px;
      font-weight: 800;
      margin-bottom: 12px;
      color: #111827;
    }

    .service-card p {
      color: var(--gray);
      font-size: 14px;
      font-family: 'Noto Sans Devanagari', 'Plus Jakarta Sans', sans-serif;
    }

    /* =========================
   PROJECTS
========================= */
    .project-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    .project-card {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      height: 380px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
      background: #111;
    }

    .project-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: .6s;
    }

    .project-card:hover img {
      transform: scale(1.1);
    }

    .project-info {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      padding: 35px;
      background: linear-gradient(to top,
          rgba(5, 8, 10, .95),
          transparent);
      color: #fff;
    }

    .project-info span {
      color: var(--gold-light);
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .project-info h3 {
      font-size: 22px;
      font-weight: 800;
      margin-top: 6px;
    }

    /* =========================
   TEAM
========================= */
    .team-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
      max-width: 920px;
      margin: 0 auto;
    }

    .team-card {
      background: #fff;
      border-radius: 14px;
      padding: 45px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      display: flex;
      align-items: center;
      gap: 35px;
      transition: .4s;
    }

    .team-card:hover {
      border-color: var(--gold);
      transform: translateY(-5px);
    }

    .team-avatar {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background:
        linear-gradient(135deg,
          var(--maroon),
          var(--maroon-dark));
      color: var(--gold-light);
      font-size: 36px;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 4px solid var(--gold);
      box-shadow: 0 10px 20px rgba(0, 0, 0, .18);
    }

    .team-info h3 {
      font-size: 24px;
      font-weight: 900;
      color: #111827;
    }

    .team-info span {
      color: var(--maroon);
      font-weight: 800;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 2px;
      display: block;
      margin: 6px 0 14px;
    }

    .team-info p {
      color: var(--gray);
      font-size: 14px;
      font-family: 'Noto Sans Devanagari', 'Plus Jakarta Sans', sans-serif;
    }

    /* =========================
   CONTACT
========================= */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 60px;
      align-items: start;
    }

    .contact-details {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 35px;
    }

    .contact-box {
      display: flex;
      gap: 20px;
      align-items: flex-start;
      padding: 22px;
      background: #fff;
      border-radius: 10px;
      border-left: 4px solid var(--gold);
      border-top: 1px solid var(--border);
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 8px 25px rgba(0, 0, 0, .04);
    }

    .contact-box i {
      font-size: 22px;
      color: var(--maroon);
      margin-top: 4px;
    }

    .contact-box h4 {
      font-size: 16px;
      font-weight: 800;
      margin-bottom: 4px;
      color: #111827;
    }

    .contact-box p {
      color: var(--gray);
      font-size: 14px;
    }

    .contact-form {
      background: #fff;
      padding: 45px;
      border-radius: 14px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .form-group {
      margin-bottom: 22px;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 8px;
      color: #334155;
    }

    .form-control {
      width: 100%;
      padding: 16px 20px;
      border: 1px solid #d8dee6;
      border-radius: 8px;
      font-size: 15px;
      background: #E2E3E8;
      color: #28BA3;
      outline: none;
      transition: .3s;
    }

    .form-control:focus {
      border-color: var(--gold);
      background: #fff;
      box-shadow: 0 0 0 4px rgba(199, 166, 108, .18);
    }

    .form-control option {
      background: #fff;
      color: #111827;
    }

    textarea.form-control {
      height: 140px;
      resize: vertical;
    }

    /* =========================
   SOCIAL MEDIA
========================= */
    .social-icons-footer {
      display: flex;
      gap: 12px;
      margin-top: 20px;
    }

    .social-icons-footer a {
      width: 42px;
      height: 42px;
      background: rgba(255, 255, 255, .05);
      border: 1px solid rgba(255, 255, 255, .15);
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: var(--gold);
      transition: .3s;
    }

    .social-icons-footer a:hover {
      background: var(--maroon);
      color: #fff;
      border-color: var(--gold);
      transform: translateY(-3px);
    }

    /* =========================
   FOOTER
========================= */
    .footer {
      background: #3D4751;
      color: #fff;
      padding: 90px 0 35px;
      border-top: 1px solid rgba(255, 255, 255, .1);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1.3fr;
      gap: 50px;
      padding-bottom: 50px;
      border-bottom: 1px solid rgba(255, 255, 255, .08);
    }

    /* FOOTER LOGO */
    .footer-logo {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 20px;
    }

    .footer-logo img {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      object-fit: contain;
      border: 2px solid var(--gold);
      background: #fff;
      display: block;
    }

    .footer-logo .logo-text span {
      color: #fff;
    }

    .footer p {
      color: #94a3b8;
      font-size: 14px;
      margin-bottom: 20px;
      font-family: 'Noto Sans Devanagari', 'Plus Jakarta Sans', sans-serif;
    }

    .footer h4 {
      font-size: 18px;
      font-weight: 900;
      margin-bottom: 22px;
      color: var(--gold-light);
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .footer-links a {
      color: #94a3b8;
      font-size: 14px;
      transition: .3s;
    }

    .footer-links a:hover {
      color: var(--gold);
      padding-left: 6px;
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 35px;
      color: #64748b;
      font-size: 13px;
      flex-wrap: wrap;
      gap: 15px;
    }

    /* =========================
   WHATSAPP
========================= */
    .whatsapp-float {
      position: fixed;
      bottom: 35px;
      right: 35px;
      width: 65px;
      height: 65px;
      background: #25d366;
      color: #fff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      box-shadow: 0 15px 30px rgba(37, 211, 102, .45);
      z-index: 999;
      transition: .3s;
    }

    .whatsapp-float:hover {
      transform: scale(1.1);
      background: #20ba5a;
    }

    /* =========================
   RESPONSIVE
========================= */
    @media(max-width:992px) {

      .about-grid,
      .contact-grid,
      .team-grid {
        grid-template-columns: 1fr;
      }

      .services-grid,
      .project-grid {
        grid-template-columns: 1fr 1fr;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .nav-menu {
        display: none;
        position: absolute;
        top: 95px;
        left: 0;
        width: 100%;
        background: #fff;
        flex-direction: column;
        padding: 35px;
        border-bottom: 1px solid rgba(0, 0, 0, .1);
        box-shadow: 0 20px 30px rgba(0, 0, 0, .12);
      }

      .nav-menu.active {
        display: flex;
      }

      .menu-toggle {
        display: block;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .team-card {
        max-width: 700px;
        margin: auto;
      }
    }

    @media(max-width:600px) {
      .topbar-info {
        gap: 12px;
      }

      .topbar {
        font-size: 11px;
      }

      .navbar {
        height: 82px;
      }

      .logo img {
        width: 52px;
        height: 52px;
      }

      .logo-text span {
        font-size: 20px;
      }

      .hero {
        min-height: calc(100vh - 82px);
        padding: 75px 0;
        background-position: center;
      }

      .hero-badge {
        font-size: 10px;
        gap: 8px;
        letter-spacing: 1.3px;
      }

      .hero-badge span::after {
        margin-left: 8px;
      }

      .hero h1 {
        font-size: 46px;
      }

      .hero p {
        font-size: 16px;
      }

      .hero-btns {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }

      .services-grid,
      .project-grid {
        grid-template-columns: 1fr;
      }

      .stats-grid {
